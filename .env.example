# Optional. Public repositories only, even when a token is configured.
GITHUB_TOKEN=
GITHUB_TIMEOUT_SECONDS=20
SCAN_TIMEOUT_SECONDS=30
MAX_PYTHON_FILES=50
MAX_FILE_BYTES=500000
MAX_TOTAL_BYTES=5000000
SEMGREP_TIMEOUT_SECONDS=120

# Optional AI review; disabled unless explicitly enabled and configured.
AI_ENABLED=false
AI_PROVIDER=
AI_MODEL=
# Full HTTPS Responses API URL, provided by the operator.
AI_ENDPOINT=
AI_API_KEY=
AI_TIMEOUT_SECONDS=30
AI_MAX_FINDINGS=3
AI_MAX_CONTEXT_CHARS=12000
AI_CONTEXT_LINES=15
AI_CHANGED_LINES_ONLY=false
AI_MAX_OUTPUT_TOKENS=1200
AI_MAX_RESPONSE_BYTES=65536
# Optional local export path (parent directory must exist). Keep exports untracked.
AI_EVALUATION_OUTPUT=
